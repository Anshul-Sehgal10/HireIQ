# Core Configuration
HOST=localhost
PORT=8000
DEBUG=True

# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/hireiq

# JWT configuration
JWT_SECRET_KEY=mysecretkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Url configuration
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# S3 or R2 configuration
STORAGE_ACCESS_KEY_ID=...
STORAGE_SECRET_ACCESS_KEY=...
STORAGE_BUCKET=hireiq-resumes
STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com   # R2
# STORAGE_REGION=auto                                                # R2
# STORAGE_ENDPOINT_URL=                                              # AWS S3 (leave empty)

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EXTRACTION_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001