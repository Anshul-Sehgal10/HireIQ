# Core Configuration
HOST=localhost
PORT=8000
DEBUG=True

# Database configuration
DATABASE_URL=postgresql+asyncpg://🤡:🫵🤣@localhost/hireiq

# JWT configuration
JWT_SECRET_KEY=🤡🫵🤣
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60 # 15 for production
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth configuration
GOOGLE_CLIENT_ID=🤡🫵🤣
GOOGLE_CLIENT_SECRET=🤡🫵🤣
LINKEDIN_CLIENT_ID=🤡🫵🤣
LINKEDIN_CLIENT_SECRET=🤡🫵🤣

# Url configuration
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# S3 or R2 configuration
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
# STORAGE_BUCKET=hireiq-resumes
# STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com   # R2
# STORAGE_REGION=auto                                                # R2
# STORAGE_ENDPOINT_URL=                                              # AWS S3 (leave empty)

# Gemini API configuration
GEMINI_API_KEY=🤡🫵🤣
GEMINI_EXTRACTION_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001