# Ignore node_modules
**/node_modules
**/node_modules/

# Ignore Next.js build output
**/.next
**/.next/

# Ignore Python virtual environments and caches
**/__pycache__
**/.venv
**/*.pyc
**/*.pyo
**/*.pyd

# Ignore local environment files and logs
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.log

# Ignore OS files
.DS_Store
Thumbs.db
